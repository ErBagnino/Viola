# =============================================================
# Viola × Adam — environment variables
# Copy to .env.local (local) or paste into Vercel → Settings → Environment Variables.
# NEVER commit real values. Only NEXT_PUBLIC_* values reach the browser.
# =============================================================

# --- Supabase (Project Settings → API) -----------------------
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...) or legacy "anon" key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...) or legacy "service_role" key — SERVER ONLY
SUPABASE_SERVICE_ROLE_KEY=

# --- Gemini (https://aistudio.google.com/apikey) --------------
GEMINI_API_KEY=
# Optional: override the model chosen in the admin (default: gemini-flash-latest).
# When a model's free quota runs out, the app moves on to the other free models by itself.
GEMINI_MODEL=

# --- Telegram (BotFather) ------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# --- Web Push (generate with: npm run vapid) -----------------
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- WhatsApp fallback (international format, digits only, e.g. 393331234567)
ADMIN_WHATSAPP_NUMBER=

# --- Optional -------------------------------------------------
# Public URL of the app (used in Telegram buttons). Auto-detected on Vercel.
NEXT_PUBLIC_SITE_URL=
# Protects the daily keep-alive cron (Vercel sets the header automatically)
CRON_SECRET=
